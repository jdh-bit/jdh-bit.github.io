{
  "publicDir": "static",
  "outputDir": "public",
  "pathPrefix": "/posts",
  "publishContent": true,
  "autoSync": true,
  "$schema": "https://tangled.org/stevedylan.dev/sequoia/raw/main/sequoia.schema.json",
  "siteUrl": "https://www.purplereview.com",
  "contentDir": "content/Posts",
  "imagesDir": "assts/img",
